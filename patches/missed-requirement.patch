+def summarise_order(order_id: int) -> OrderSummary:
+    order = get_order(order_id)
+    subtotal = sum(line.quantity * line.unit_price_pence for line in order.lines)
+    discount = min(order.discount_pence, subtotal)
+    total = calculate_total(order.lines, order.discount_pence)
+    shipping = total - (subtotal - discount)
+    return OrderSummary(
+        id=order.id,
+        status=order.status,
+        item_count=sum(line.quantity for line in order.lines),
+        subtotal_pence=subtotal,
+        discount_pence=discount,
+        shipping_pence=shipping,
+        total_pence=total,
