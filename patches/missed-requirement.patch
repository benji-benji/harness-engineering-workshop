diff --git a/tests/test_order_summary.py b/tests/test_order_summary.py
new file mode 100644
index 0000000..d8bf5dc
--- /dev/null
+++ b/tests/test_order_summary.py
@@ -0,0 +1,127 @@
+from typing import Any
+
+from fastapi.testclient import TestClient
+
+from shop.app import app
+from shop.repositories.orders import OrderLine
+from shop.services import orders as orders_service
+
+client = TestClient(app)
+
+
+def summary_of(lines: list[OrderLine], discount_pence: int = 0) -> dict[str, Any]:
+    order = orders_service.place_order("ada", lines, discount_pence)
+    response = client.get(f"/orders/{order.id}/summary")
+    assert response.status_code == 200
+    return response.json()
+
+
+def mixed_lines() -> list[OrderLine]:
+    return [OrderLine("mug", 2, 750), OrderLine("pen", 3, 120)]
+
+
+def threshold_lines() -> list[OrderLine]:
+    return [OrderLine("lamp", 1, 3000), OrderLine("desk tidy", 2, 1000)]
+
+
+def test_summary_returns_every_field() -> None:
+    order = orders_service.place_order("ada", mixed_lines())
+    response = client.get(f"/orders/{order.id}/summary")
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": order.id,
+        "status": "open",
+        "item_count": 5,
+        "subtotal_pence": 1860,
+        "discount_pence": 0,
+        "shipping_pence": 399,
+        "total_pence": 2259,
+        "vat_pence": 377,
+    }
+
+
+def test_summary_id_is_the_order_id() -> None:
+    order = orders_service.place_order("ada", mixed_lines())
+    assert client.get(f"/orders/{order.id}/summary").json()["id"] == order.id
+
+
+def test_summary_status_is_the_order_status() -> None:
+    assert summary_of(mixed_lines())["status"] == "open"
+
+
+def test_summary_item_count_sums_quantities_not_lines() -> None:
+    assert summary_of(mixed_lines())["item_count"] == 2 + 3
+
+
+def test_summary_subtotal_sums_quantity_times_unit_price() -> None:
+    assert summary_of(mixed_lines())["subtotal_pence"] == 2 * 750 + 3 * 120
+
+
+def test_summary_discount_is_the_discount_applied() -> None:
+    assert summary_of([OrderLine("lamp", 2, 3000)], discount_pence=2000)["discount_pence"] == 2000
+
+
+def test_summary_discount_larger_than_subtotal_is_capped_at_subtotal() -> None:
+    summary = summary_of([OrderLine("pen", 1, 120)], discount_pence=500)
+    assert summary["subtotal_pence"] == 120
+    assert summary["discount_pence"] == 120
+    assert summary["shipping_pence"] == 399
+    assert summary["total_pence"] == 399
+    assert summary["vat_pence"] == 67
+
+
+def test_summary_shipping_is_charged_below_the_threshold() -> None:
+    assert summary_of(mixed_lines())["shipping_pence"] == 399
+
+
+def test_summary_shipping_is_free_at_the_threshold() -> None:
+    summary = summary_of(threshold_lines())
+    assert summary["subtotal_pence"] == 5000
+    assert summary["shipping_pence"] == 0
+    assert summary["total_pence"] == 5000
+
+
+def test_summary_shipping_uses_the_discounted_subtotal() -> None:
+    summary = summary_of([OrderLine("lamp", 2, 3000)], discount_pence=2000)
+    assert summary["shipping_pence"] == 399
+    assert summary["total_pence"] == 4399
+
+
+def test_summary_total_matches_calculate_total() -> None:
+    cases: list[tuple[list[OrderLine], int]] = [
+        (mixed_lines(), 0),
+        (threshold_lines(), 0),
+        ([OrderLine("pen", 1, 120)], 500),
+        ([OrderLine("lamp", 2, 3000)], 2000),
+    ]
+    for lines, discount_pence in cases:
+        expected = orders_service.calculate_total(lines, discount_pence)
+        assert summary_of(lines, discount_pence)["total_pence"] == expected
+
+
+def test_summary_vat_is_one_sixth_of_the_total_rounded_half_up() -> None:
+    assert summary_of(mixed_lines())["vat_pence"] == 377  # 2259 / 6 = 376.5
+    assert summary_of(threshold_lines())["vat_pence"] == 833  # 5000 / 6 = 833.33
+    assert summary_of([OrderLine("tape", 1, 2)])["vat_pence"] == 67  # 401 / 6 = 66.83
+
+
+def test_summary_of_an_unknown_order_is_the_same_404_as_reading_it() -> None:
+    summary = client.get("/orders/999/summary")
+    order = client.get("/orders/999")
+    assert summary.status_code == 404
+    assert summary.json() == order.json() == {"error": "Order 999 not found"}
+
+
+def test_summarise_order_is_the_service_behind_the_route() -> None:
+    order = orders_service.place_order("ada", threshold_lines())
+    summary = orders_service.summarise_order(order.id)
+    assert client.get(f"/orders/{order.id}/summary").json() == {
+        "id": summary.id,
+        "status": summary.status,
+        "item_count": summary.item_count,
+        "subtotal_pence": summary.subtotal_pence,
+        "discount_pence": summary.discount_pence,
+        "shipping_pence": summary.shipping_pence,
+        "total_pence": summary.total_pence,
+        "vat_pence": summary.vat_pence,
+    }
